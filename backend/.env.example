PORT=4000
JWT_SECRET=cambie-esta-en-su-entorno
MYSQL_URL=
TOKEN_EXPIRES=12h

# Configuración alternativa (usar MYSQL_URL o estas variables, no ambas).
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=smartroad_sos
MYSQL_CONNECTION_LIMIT=10

# Configuración del CRUD singular solicitado
CRUD_DB_HOST=127.0.0.1
CRUD_DB_PORT=3306
CRUD_DB_USER=root
CRUD_DB_PASSWORD=cambia-esta-clave
CRUD_DB_NAME=smartroad_sos
CRUD_DB_CONNECTION_LIMIT=10

# Correo de bienvenida al registrar conductores (paso 3).
# Opción A (recomendada, gratuita): Resend — solo ponga la key.
RESEND_API_KEY=
# Opción B: SMTP clásico (Nodemailer).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartRoad S.O.S <no-reply@smartroad.local>
# Link de descarga del APK (Drive, Releases o App Distribution).
APK_DOWNLOAD_URL=
# APK servido por el propio backend. Si existe, el correo puede adjuntarlo
# (cuando pesa menos que APK_MAX_ATTACH_MB) y también ofrece descarga directa.
# Por defecto se busca en mobile/build/app/outputs/flutter-apk/app-release.apk
APK_FILE_PATH=
# Límite de adjunto. Gmail/SMTP suele aceptar ~15-20 MB; Resend hasta ~25 MB.
APK_MAX_ATTACH_MB=15
# URL pública del backend (Render la inyecta como RENDER_EXTERNAL_URL).
# Se usa para construir el enlace /api/app/apk dentro del correo.
PUBLIC_BASE_URL=

# IA con Groq (SOLO backend: la key nunca va en frontend ni app).
# Cree la key gratis en https://console.groq.com/keys
GROQ_API_KEY=
# Modelos (ver https://console.groq.com/docs/models). Visión para la cámara.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MAX_RETRIES=2
