services:
  db:
    image: mysql:8.4
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-root_local_change_me}
      MYSQL_DATABASE: smartroad_sos
      MYSQL_USER: smartroad
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:-smartroad_local_change_me}
    volumes:
      - smartroad_mysql_data:/var/lib/mysql
      - ./backend/database/schema.sql:/docker-entrypoint-initdb.d/01-schema.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -uroot -p\"$$MYSQL_ROOT_PASSWORD\" --silent"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 30s

  backend:
    build:
      context: .
      dockerfile: Dockerfile
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: 4000
      JWT_SECRET: ${JWT_SECRET:-cambiar-esta-clave-antes-de-usar}
      TOKEN_EXPIRES: 12h
      MYSQL_URL: mysql://smartroad:${MYSQL_PASSWORD:-smartroad_local_change_me}@db:3306/smartroad_sos
      CORS_ORIGIN: http://localhost:4001
    ports:
      - "4001:4000"
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:4000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 40s

volumes:
  smartroad_mysql_data:

